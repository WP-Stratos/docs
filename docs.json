  "seo": {
    "organization": {
      "name": "WP Stratos",
      "legalName": "WP Stratos",
      "url": "https://wpstratos.com",
      "logo": "https://wpstratos.com/images/wpstratos-logomark-light.png",
      "sameAs": [
        "https://github.com/WP-Stratos",
        "https://linkedin.com/company/wpstratos",
        "https://www.instagram.com/wpstratos"
      ]
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-LNHLBN4K2N"
    },
    "telemetry": {
      "enabled": true
    }
  },
  "interaction": {
    "drilldown": true
  },
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/introduction",
      "permanent": true
    }
  ],
  "icons": {
    "library": "lucide"
  },
  "metadata": {
    "timestamp": true
  }
