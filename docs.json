{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "WP Stratos",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": {
    "light": "/images/wpstratos-logomark-light.png",
    "dark": "/images/wpstratos-logomark-dark.png"
  },
  "logo": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:missioncontrol@wpstratos.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Cloud Login",
      "href": "https://cloud.wpstratos.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Domains & DNS",
            "pages": [
              "domains/connect-domain",
              "domains/dns-configuration",
              "domains/nameserver-setup",
              "domains/ssl-certificates"
            ]
          },
          {
            "group": "Cloud Panel",
            "pages": [
              "cloud-panel/overview",
              "cloud-panel/sites",
              "cloud-panel/migrate-a-site",
              "cloud-panel/backups",
              "cloud-panel/developer-settings",
              "cloud-panel/security-and-account",
              "cloud-panel/plugins-and-themes",
              "cloud-panel/edge-cache-and-cloudflare",
              "cloud-panel/logs",
              "cloud-panel/staging"
            ]
          }
        ],
        "icon": "rocket-vertical"
      },
      {
        "tab": "Plugins",
        "groups": [
          {
            "group": "WP Postman",
            "pages": [
              "plugins/wp-postman/overview",
              "plugins/wp-postman/smtp-configuration",
              "plugins/wp-postman/email-logs"
            ],
            "icon": "send"
          },
          {
            "group": "Aero",
            "pages": [
              "plugins/aero/overview",
              "plugins/aero/caching",
              "plugins/aero/edge-cache",
              "plugins/aero/cache-warmer",
              "plugins/aero/purge-schedule",
              "plugins/aero/optimization",
              "plugins/aero/images",
              "plugins/aero/experimental",
              "plugins/aero/debug"
            ]
          },
          {
            "group": "WP Stratos Environment",
            "pages": [
              "plugins/wp-stratos-environment/overview",
              "plugins/wp-stratos-environment/php-settings",
              "plugins/wp-stratos-environment/server-info"
            ]
          }
        ],
        "icon": "plug"
      },
      {
        "tab": "Troubleshooting",
        "groups": [
          {
            "group": "Common Issues",
            "pages": [
              "troubleshooting/domain-propagation",
              "troubleshooting/email-delivery",
              "troubleshooting/cache-issues",
              "troubleshooting/plugin-reactivation"
            ]
          },
          {
            "group": "FAQ",
            "pages": [
              "troubleshooting/faq"
            ]
          },
          {
            "group": "Clarifications",
            "icon": "circle-question",
            "pages": [
              "troubleshooting/what-is-wp-stratos",
              "troubleshooting/apache-stratos-retired"
            ]
          }
        ],
        "icon": "bug-slash"
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "appearance": {
    "strict": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "aistudio",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "params": {
      "expanded": "closed"
    },
    "playground": {
      "display": "interactive"
    }
  },
  "description": "Documentation, guides, tutorials for WP Stratos, recognized as the fastest WordPress hosting in benchmarks. Deep WordPress integrations and support.",
  "seo": {
    "organization": {
      "name": "WP Stratos",
      "legalName": "WP Stratos",
      "url": "https://wpstratos.com",
      "logo": "https://wpstratos.com/images/wpstratos-logomark-light.png",
      "sameAs": [
        "http://linkedin.com/company/wpstratos",
        "https://www.instagram.com/wpstratos/"
      ]
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-LNHLBN4K2N"
    },
    "telemetry": {
      "enabled": true
    }
  }
}
