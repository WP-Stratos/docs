{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "WP Stratos",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": {
    "light": "/images/wpstratos-logomark.svg",
    "dark": "/images/wpstratos-logomark-dark.svg"
  },
  "logo": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:missioncontrol@wpstratos.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Cloud Panel",
      "href": "https://my.wpstratos.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Domains & DNS",
            "pages": [
              "domains/connect-domain",
              "domains/dns-configuration",
              "domains/nameserver-setup",
              "domains/ssl-certificates"
            ]
          },
          {
            "group": "Cloud Panel",
            "pages": [
              "cloud-panel/overview",
              "cloud-panel/sites",
              "cloud-panel/backups",
              "cloud-panel/staging"
            ]
          }
        ]
      },
      {
        "tab": "Plugins",
        "groups": [
          {
            "group": "WP Postman",
            "pages": [
              "plugins/wp-postman/overview",
              "plugins/wp-postman/smtp-configuration",
              "plugins/wp-postman/email-logs"
            ]
          },
          {
            "group": "Aero",
            "pages": [
              "plugins/aero/overview",
              "plugins/aero/caching",
              "plugins/aero/edge-cache",
              "plugins/aero/cache-warmer",
              "plugins/aero/purge-schedule",
              "plugins/aero/optimization",
              "plugins/aero/images",
              "plugins/aero/experimental",
              "plugins/aero/debug"
            ]
          },
          {
            "group": "WP Stratos Environment",
            "pages": [
              "plugins/wp-stratos-environment/overview",
              "plugins/wp-stratos-environment/php-settings",
              "plugins/wp-stratos-environment/server-info"
            ]
          }
        ]
      },
      {
        "tab": "Troubleshooting",
        "groups": [
          {
            "group": "Common Issues",
            "pages": [
              "troubleshooting/domain-propagation",
              "troubleshooting/email-delivery",
              "troubleshooting/cache-issues",
              "troubleshooting/plugin-reactivation"
            ]
          },
          {
            "group": "FAQ",
            "pages": [
              "troubleshooting/faq"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "appearance": {
    "strict": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "aistudio",
      "cursor"
    ],
    "display": "toc"
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "params": {
      "expanded": "closed"
    },
    "playground": {
      "display": "interactive"
    }
  }
}
